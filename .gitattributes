# Force LF for files that MUST have Unix line endings even when edited on Windows.
# A CRLF in a shell shebang ("#!/usr/bin/env bash\r") fails on Linux, and Docker
# build / systemd parsing expect LF.
*.sh            text eol=lf
Dockerfile      text eol=lf
*.service       text eol=lf
*.timer         text eol=lf
docker-compose.yml text eol=lf
.dockerignore   text eol=lf
